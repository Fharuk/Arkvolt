# ==========================================================================
# ARKVOLT API — environment
# Copy to `.env` and fill in. Never commit the filled copy.
# ==========================================================================

# Local development database. On Render, paste the "Internal Database URL".
DATABASE_URL="postgresql://arkvolt:arkvolt@localhost:5432/arkvolt?schema=public"

# 32+ characters. Generate with:  openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="12h"

NODE_ENV="development"
PORT=4000
LOG_LEVEL="debug"

# Comma-separated. Leave empty in development to reflect any origin.
# In production this MUST list your Vercel domain exactly:
#   https://arkvolt.ng,https://www.arkvolt.ng
CORS_ORIGINS=""

# ---- Cloudinary (image storage) ------------------------------------------
# Leave blank in development: uploads fall back to ./uploads and are served
# from /uploads. In production these three are REQUIRED — the API refuses
# to write to local disk because Render's filesystem is ephemeral.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="arkvolt"

# ---- Business -------------------------------------------------------------
# The admin's WhatsApp line. 234 + number, no plus, no spaces.
WHATSAPP_NUMBER="2349030438653"

# ---- First administrator --------------------------------------------------
# Seeds the admin account on first `npm run db:seed`, and is the only way to
# create the very first sign-in via POST /api/admin/auth/bootstrap.
ADMIN_EMAIL="admin@arkvolt.ng"
ADMIN_NAME="Arkvolt Admin"
ADMIN_PASSWORD=""
